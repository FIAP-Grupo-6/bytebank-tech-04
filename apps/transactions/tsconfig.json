{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@bytebank/domain": [
        "../../packages/domain/src"
      ],
      "@bytebank/infrastructure": [
        "../../packages/infrastructure/src"
      ],
      "@bytebank/infrastructure/next": [
        "../../packages/infrastructure/src/next"
      ],
      "@bytebank/ui": [
        "../../packages/ui/src"
      ],
      "@bytebank/ui/tailwind-preset": [
        "../../packages/ui/tailwind-preset.js"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
