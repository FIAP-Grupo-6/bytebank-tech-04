# URL da API REST (usada SOMENTE no servidor — BFF, Server Components, NextAuth).
# Desde a Fase 4 o browser não conversa com a API; não use NEXT_PUBLIC_.
API_URL=http://localhost:3000

# URL da zona de transações (usada nos rewrites — server-side)
TRANSACTIONS_URL=http://localhost:3001

# NextAuth — o MESMO valor deve estar na zona transactions.
# Também é a chave-mestra (via HKDF) da criptografia das preferências e do
# HMAC do webhook interno de cache. Em produção: openssl rand -base64 32
NEXTAUTH_SECRET=bytebank-dev-secret-troque-em-producao
NEXTAUTH_URL=http://localhost:3002
